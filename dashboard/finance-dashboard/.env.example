# ---- Auth.js ----
# Generate with: npx auth secret
AUTH_SECRET=

# Google OAuth client (Google Cloud Console > Credentials > OAuth 2.0 Client ID)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated list of emails allowed to sign in. Everyone else is rejected.
ALLOWED_EMAILS=you@gmail.com

# ---- Google Sheets ----
# The long ID from your sheet URL:
# https://docs.google.com/spreadsheets/d/THIS_PART/edit
# Used as the default/fallback sheet for anyone not listed in SHEET_MAP.
SHEET_ID=

# Optional: per-user sheets. JSON mapping each allowed email to their own
# sheet id. Anyone not listed here falls back to SHEET_ID. Every mapped sheet
# must be shared (Viewer) with the service account's client_email.
#   SHEET_MAP={"you@gmail.com":"SHEET_ID_1","her@gmail.com":"SHEET_ID_2"}
SHEET_MAP=

# Service account JSON key, base64-encoded as a single line.
# Generate with: base64 -i service-account.json | tr -d '\n'
GOOGLE_SERVICE_ACCOUNT_KEY_B64=
